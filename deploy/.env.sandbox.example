POSTGRES_USER=secretary
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=aidasecretary

# Proposed package names; confirm that app CI publishes these.
# Set tags to immutable commit-SHA/release tags; do not use latest.
BACKEND_IMAGE=ghcr.io/aabrovarnik/ai-da-secretary-backend
BACKEND_TAG=sha-REPLACE_WITH_COMMIT_SHA
FRONTEND_IMAGE=ghcr.io/aabrovarnik/ai-da-secretary-frontend
FRONTEND_TAG=sha-REPLACE_WITH_COMMIT_SHA

FRONTEND_PORT=18080
BACKEND_PORT=18081

SESSION_SECRET=change-me-min-16-characters
ACCESS_TOKEN_TTL_HOURS=8

OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
ASR_MODEL=whisper-1

MAX_UPLOAD_MB=50
LOCAL_AUDIO_STORAGE_PATH=./storage/audio
